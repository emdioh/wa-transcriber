# Extra applets the network manager and the init scripts need.
CONFIG_NTPD=y
CONFIG_NTPD_EXTRA_ARGS=y
CONFIG_UDHCPC=y
CONFIG_UDHCPC_DEFAULT_SCRIPT="/usr/share/udhcpc/default.script"
CONFIG_IP=y
CONFIG_ARPING=y
CONFIG_WATCHDOG=y
CONFIG_MDEV=y
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_BLKDIR=y
CONFIG_MOUNTPOINT=y
CONFIG_MODPROBE=y
CONFIG_KILLALL=y
CONFIG_SLEEP=y
