# WiFi and watchdog drivers used by the network manager (M5).
# Built as modules: mdev loads them from /etc/init.d/S90watchdog and the
# WiFi driver is loaded on demand by the USB bus.
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFkill=y

# Ralink RT5370 (common cheap dongle) and MediaTek MT7612U. Neither is AP
# capable out of the box without a firmware file: mt76x2u asks for
# mt7662.bin/mt7662_rom_patch.bin, which the images ship through
# BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT76X2E (see the defconfigs).
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
CONFIG_RT2800_LIB=m
CONFIG_MT76_CORE=m
CONFIG_MT76_USB=m
CONFIG_MT76x2_COMMON=m
CONFIG_MT76x2U=m

# Realtek RTL8188/8192 USB dongles (rtl8xxxu). The driver only advertises
# STATION + MONITOR (no AP in Linux 6.1), so such a dongle can join a network
# as a client but can never serve the setup AP: RT5370/MT7612U stay the
# supported ones. Firmware: BR2_PACKAGE_LINUX_FIRMWARE_RTL_81XX.
CONFIG_RTL8XXXU=m

# Watchdogs: Raspberry Pi (bcm2835) and BeagleBone Black (omap).
CONFIG_BCM2835_WDT=m
CONFIG_OMAP_WDT=m
