# /etc/inittab
#
# BusyBox init, no runlevels. WAT variant of Buildroot's default:
#  - the root filesystem is mounted read-only and never remounted rw;
#  - the transcriber itself is respawned by init, so a crash comes back
#    without any supervisor (and a watchdog reset restarts everything).

# Startup the system
::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
# /run/lock lives on the tmpfs mounted by "mount -a" above.
::sysinit:/bin/mkdir -p /run/lock/subsys
null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
::sysinit:/bin/hostname -F /etc/hostname
# now run any rc scripts (S01data creates /data)
::sysinit:/etc/init.d/rcS

# The transcriber: one process, restarted when it exits.
#
# -update-dir /data/bin turns on binary self-updates (D17): this factory
# binary verifies the signed release and execs the version on /data before it
# does anything else. -bootstrap is what a restart re-execs, so /data/bin
# always goes through this gate instead of skipping it.
::respawn:/usr/bin/wa-transcriber -data /data -network managed -listen :80 -watchdog /dev/watchdog -update-dir /data/bin -bootstrap /usr/bin/wa-transcriber -image-update /data

# Debug shell: prefer the console= line in wat.txt (S02console), which also
# covers the USB gadget and HDMI. This manual line is a last resort.
#ttyS0::respawn:/sbin/getty -L 115200 ttyS0 vt100

# Stuff to do before rebooting
::shutdown:/etc/init.d/rcK
::shutdown:/bin/umount -a -r
