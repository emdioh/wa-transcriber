# /etc/inittab
#
# BusyBox init, no runlevels. WAT variant of Buildroot's default:
#  - the root filesystem is mounted read-only and never remounted rw;
#  - the transcriber itself is respawned by init, so a crash comes back
#    without any supervisor (and a watchdog reset restarts everything).

# Startup the system
::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mkdir -p /dev/pts /dev/shm /run/lock/subsys /tmp /var/log
::sysinit:/bin/mount -a
null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
::sysinit:/bin/hostname -F /etc/hostname
# now run any rc scripts (S01data creates /data)
::sysinit:/etc/init.d/rcS

# The transcriber: one process, restarted when it exits.
::respawn:/usr/bin/wa-transcriber -data /data -network managed -listen :80 -watchdog /dev/watchdog

# Serial console for debugging (uncomment on the serial header).
#ttyS0::respawn:/sbin/getty -L ttyS0 115200 vt100

# Stuff to do before rebooting
::shutdown:/etc/init.d/rcK
::shutdown:/bin/umount -a -r
