#!/bin/sh
#
# Optional debug console, chosen with "console=" in wat.txt:
#
#	console=off      nothing (default)
#	console=serial   login shell on the board's UART header
#	console=usb      login shell over the USB client port (CDC-ACM gadget)
#	console=hdmi     login shell on tty1, the HDMI/analog output (a USB
#	                 keyboard on the host port drives it)
#	console=both     serial + usb
#	console=all      serial + usb + hdmi
#
# The root password is empty, so this is a root shell without a password:
# enable it only on a card you keep, and only while debugging.
#
# Called from rcS, after S00boot has mounted /boot.

# Messages go to the kernel log, which the kernel prints on every active
# console: the serial header, HDMI and the USB gadget. That way the reason a
# console did not start is visible even when no console started.
log() {
	echo "S02console: $*" >/dev/kmsg 2>/dev/null || echo "S02console: $*"
}

# Last value of key=value in wat.txt, with Windows line endings and inline
# comments tolerated (the boot partition is FAT and gets edited on other
# machines).
wat_value() {
	[ -r /boot/wat.txt ] || return 1
	tr -d '\r' </boot/wat.txt |
		sed -e 's/[[:space:]]*#.*$//' |
		sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" |
		sed -e 's/[[:space:]]*$//' | tail -n 1
}

# spawn <tty>: getty in a loop, so a login that ends (or a tty that is not
# ready yet) starts a new one a second later, like init::respawn would.
spawn() {
	dev="$1"
	(
		sleep 1
		while :; do
			/sbin/getty -L 115200 "$dev" vt100
			sleep 1
		done
	) &
}

# The console UART, told apart by the model string: the BeagleBone uses
# 8250_omap (ttyS0, ttyO0 was the name before Linux 4.11), the Raspberry Pi 2
# exposes the PL011 as ttyAMA0 (ttyS0 there is the mini UART on other pins).
serial_dev() {
	model=$(tr -d '\0' </proc/device-tree/model 2>/dev/null)
	case "$model" in
	*BeagleBone*) echo ttyS0 ;;
	*Raspberry*) echo ttyAMA0 ;;
	*) for d in ttyS0 ttyAMA0; do
		if [ -c "/dev/$d" ]; then
			echo "$d"
			return
		fi
	done ;;
	esac
}

# usb_acm exposes a CDC-ACM port on the USB client port through configfs
# (the kernel has CONFIG_USB_CONFIGFS_ACM=y, so nothing has to be loaded),
# then starts a getty on the /dev/ttyGS0 it creates.
usb_acm() {
	mountpoint -q /sys/kernel/config || mount -t configfs none /sys/kernel/config || return 1
	g=/sys/kernel/config/usb_gadget/wat
	if [ ! -d "$g" ]; then
		mkdir -p "$g" || return 1
		echo 0x1d6b >"$g/idVendor"  # Linux Foundation
		echo 0x0104 >"$g/idProduct" # Multifunction Composite Gadget
		echo 0x0100 >"$g/bcdUSB"
		echo 0x0100 >"$g/bcdDevice"
		mkdir -p "$g/strings/0x409"
		echo "wa-transcriber" >"$g/strings/0x409/serialnumber"
		echo "wa" >"$g/strings/0x409/manufacturer"
		echo "wa-transcriber console" >"$g/strings/0x409/product"
		mkdir -p "$g/configs/c.1/strings/0x409"
		echo "acm" >"$g/configs/c.1/strings/0x409/configuration"
		mkdir -p "$g/functions/acm.usb0" || return 1
		ln -s "$g/functions/acm.usb0" "$g/configs/c.1/" 2>/dev/null
	fi
	udc=$(ls /sys/class/udc 2>/dev/null | head -n 1)
	if [ -z "$udc" ]; then
		log "no USB device controller: is the port in peripheral mode?"
		return 1
	fi
	echo "$udc" >"$g/UDC" || return 1
	i=0
	while [ ! -c /dev/ttyGS0 ] && [ "$i" -lt 25 ]; do
		sleep 0.2
		i=$((i + 1))
	done
	if [ ! -c /dev/ttyGS0 ]; then
		log "ttyGS0 did not appear"
		return 1
	fi
	spawn ttyGS0
}

mode=$(wat_value console) || mode=
case "$mode" in
off | "" ) exit 0 ;;
serial | usb | hdmi | both | all) ;;
*)
	log "unknown console=$mode in wat.txt, want off, serial, usb, hdmi, both or all"
	exit 0
	;;
esac

log "debug console: $mode (root shell, no password)"

case "$mode" in
serial | both | all)
	dev=$(serial_dev)
	if [ -c "/dev/$dev" ]; then
		spawn "$dev"
	else
		log "no /dev/$dev for the serial console"
	fi
	;;
esac

case "$mode" in
usb | both | all)
	usb_acm || log "USB console not available"
	;;
esac

case "$mode" in
hdmi | all)
	if [ -c /dev/tty1 ]; then
		spawn tty1
	else
		log "no /dev/tty1 for the HDMI console"
	fi
	;;
esac
