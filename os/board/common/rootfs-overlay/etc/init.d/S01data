#!/bin/sh
#
# Create and mount the DATA partition on first boot.
#
# The image ships with three partitions: boot (FAT), root A (p2) and root B
# (p3), both ext4 and read-only. DATA is p4 (ext4, label DATA); it is made
# the first time the device boots on a card that has no DATA filesystem yet,
# so the image stays small and the card can be of any size.
#
# Called from rcS before anything writes to /data.
#
# Must be idempotent, and a power cut at any point must not brick the card:
# an existing DATA filesystem is never created, formatted or touched again,
# and none of the three system partitions is ever picked, whatever its label.
# An image update leaves DATA alone, which is why it survives an OS update.

log() {
	echo "S01data: $*" >/dev/kmsg 2>/dev/null || echo "S01data: $*"
}

. /usr/lib/wat/sd.sh

# Root device, e.g. /dev/mmcblk0p2 (root A) or /dev/mmcblk0p3 (root B) once an
# image update has switched slots. /proc/mounts calls it /dev/root, so the
# device comes from /sys/dev/block (see sd.sh).
rootdev=$(wat_rootdev) || rootdev=
if [ -z "$rootdev" ]; then
	log "cannot find the root block device, /data stays unmounted"
	exit 0
fi
disk=$(wat_disk "$rootdev") || disk=
if [ -z "$disk" ]; then
	log "root device $rootdev is not a partition of a disk, /data stays unmounted"
	exit 0
fi

# Partition numbers of the fixed layout: the two root slots (D18) and DATA.
root_a=$(wat_part "$disk" 2)
root_b=$(wat_part "$disk" 3)
datadev=$(wat_part "$disk" 4)

wait_for_block() {
	i=0
	while [ ! -b "$1" ] && [ "$i" -lt 50 ]; do
		sleep 0.2
		i=$((i + 1))
	done
	[ -b "$1" ]
}

# Find DATA by label. Only the partitions after the system's are asked, and
# never root A or root B: an image update writes a filesystem into a root slot
# and a stale or copied label must not make DATA out of it. Succeeds when
# $datadev carries a usable DATA filesystem.
find_data() {
	for dev in "$datadev" $(wat_part "$disk" 5) $(wat_part "$disk" 6) \
		$(wat_part "$disk" 7) $(wat_part "$disk" 8); do
		[ -b "$dev" ] || continue
		[ "$(blkid -o value -s LABEL "$dev" 2>/dev/null)" = "DATA" ] || continue
		datadev="$dev"
		return 0
	done
	return 1
}

if find_data; then
	log "DATA found on $datadev"
elif [ -b "$datadev" ]; then
	# A DATA partition that is there but carries no label yet (power cut
	# during the first boot) is formatted below, unless it holds another
	# filesystem.
	log "partition 4 on $disk has no DATA label"
else
	# Layout with only p1-p3 (an image from before the second root slot)
	# that already holds DATA on p3: keep it where it is instead of adding a
	# p4 next to it.
	if [ -b "$root_b" ] && [ "$(blkid -o value -s LABEL "$root_b" 2>/dev/null)" = "DATA" ]; then
		datadev="$root_b"
		log "DATA found on $datadev (old layout, no p4), leaving the table alone"
	else
		log "no partition 4 on $disk, creating DATA"
		# start=(first free), size=rest of the disk, type=83 (Linux). The
		# table is written once; a power cut before sfdisk returns leaves
		# either "no p4" or "p4 without a filesystem", both handled above.
		# Let sfdisk re-read the table itself (it adds the partition with the
		# BLKPG ioctl, which works while the disk is in use and mounted).
		# --no-reread: the root filesystem is on this disk, so sfdisk refuses
		# to touch it while it is in use. The kernel learns about the new
		# partition through BLKPG instead (partx -a), which works on a mounted
		# disk; a full BLKRRPART (blockdev --rereadpt) would come back with
		# EBUSY. sfdisk does not overwrite an existing partition, so running
		# this twice is harmless.
		if ! printf ',+,83\n' | sfdisk --append --no-reread "$disk"; then
			log "sfdisk failed, /data stays unmounted"
			exit 0
		fi
		partx -a --nr 4 "$disk" 2>/dev/null || true
		mdev -s 2>/dev/null || true
		if ! wait_for_block "$datadev"; then
			log "$datadev did not appear, /data stays unmounted"
			exit 0
		fi
	fi
fi

# A partition that exists but carries no filesystem (power cut during the
# first boot) is formatted here; an existing DATA filesystem is never
# touched, and a foreign filesystem is left alone.
fs=$(blkid -o value -s TYPE "$datadev" 2>/dev/null)
label=$(blkid -o value -s LABEL "$datadev" 2>/dev/null)
log "$datadev: type=${fs:-none} label=${label:-none}"
if [ "$label" != "DATA" ]; then
	if [ -n "$fs" ]; then
		log "$datadev carries $fs but no DATA label, leaving it alone"
		exit 0
	fi
	log "formatting $datadev as DATA"
	if ! mkfs.ext4 -q -L DATA "$datadev"; then
		log "mkfs.ext4 failed, /data stays unmounted"
		exit 0
	fi
fi

mkdir -p /data
# Mount the device, not LABEL=DATA: the tag lookup goes through blkid and
# failed even when the label was on the partition.
if mount -t ext4 -o noatime,nodev,nosuid "$datadev" /data; then
	log "DATA mounted from $datadev"
else
	# A filesystem interrupted by a power cut is repaired once, then
	# mounted again; a healthy one is never touched (e2fsck -p exits 0).
	log "mounting $datadev failed, checking the filesystem once"
	if e2fsck -p "$datadev" && mount -t ext4 -o noatime,nodev,nosuid "$datadev" /data; then
		log "DATA mounted from $datadev after e2fsck"
	else
		log "mounting $datadev at /data failed, /data stays unmounted"
		exit 0
	fi
fi

# --- /data migration from the card this image was installed from (M11) -----
#
# "Install this card to the internal storage" copies the card's system
# partitions onto the eMMC and then writes /boot/wat-migrate on the *boot*
# partition of that same card, which was copied too: the marker travels with
# the clone and the first start from the internal storage finds it here. It
# names the card's DATA partition and the files that keep the device itself
# (the settings, the WhatsApp session with its WAL and shared-memory sidecar,
# the WiFi networks); the new /data was just created empty above.
#
# Safe against a power cut at any point: every file is copied to a temp name
# in /data, fsynced and renamed into place, and the marker is only deleted
# after all of them are in. A run that dies half way leaves the marker in
# place and the next start copies everything again onto the files it already
# wrote — the copy is idempotent because the source is never modified (it is
# mounted read-only, nodev and nosuid, and only read). The source partition
# is the card, which stays in the slot until this runs once; a reboot after
# the copy finds the marker gone.
migrate_from_marker() {
	marker=/boot/wat-migrate
	[ -f "$marker" ] || return 0
	from=$(sed -n 's/^from //p' "$marker" | head -n 1)
	# Only a partition device, never a path from a card reader: the marker
	# sits on a FAT filesystem anyone can edit.
	case "$from" in
	/dev/*) ;;
	*)
		log "wat-migrate names no device ($from), ignoring it"
		rm -f "$marker"
		return 0
		;;
	esac
	if [ ! -b "$from" ]; then
		log "wat-migrate names $from, which is not a block device: keeping the marker"
		return 0
	fi
	# The old DATA is mounted read-only for the duration. It is not mounted
	# at /data: that is the new, empty partition. nosuid/nodev because it is
	# only ever read from.
	mnt=/run/wat-migrate
	mkdir -p "$mnt"
	if ! mount -t ext4 -o ro,nodev,nosuid,noatime "$from" "$mnt"; then
		log "cannot mount $from read-only, keeping the marker for the next start"
		rmdir "$mnt" 2>/dev/null || true
		return 0
	fi
	copied=0
	for name in $(sed -n 's/^file //p' "$marker"); do
		# A name with a slash would escape /data; the marker is writable by
		# whoever has the card.
		case "$name" in
		*/* | . | .. | "")
			log "wat-migrate lists an unsafe name ($name), skipping it"
			continue
			;;
		esac
		[ -f "$mnt/$name" ] || continue
		# Temp name in /data, fsync, rename: a power cut leaves either the
		# old file or the complete new one, never half of one.
		tmp="/data/.$name.migrating"
		rm -f "$tmp"
		if ! cp "$mnt/$name" "$tmp"; then
			log "copying $name from $from failed, keeping the marker"
			sync
			umount "$mnt"
			rmdir "$mnt" 2>/dev/null || true
			return 0
		fi
		sync
		if ! mv -f "$tmp" "/data/$name"; then
			log "renaming $name into place failed, keeping the marker"
			rm -f "$tmp"
			sync
			umount "$mnt"
			rmdir "$mnt" 2>/dev/null || true
			return 0
		fi
		copied=$((copied + 1))
	done
	# The rename of one file is durable on its own; the loop above syncs
	# after each copy, and this one flushes what is left before the marker
	# goes away (fsync on a directory is not something busybox offers, so a
	# power cut in the microsecond between the last rename and the marker's
	# deletion costs one more run of this block, never a lost file).
	sync
	umount "$mnt" || log "unmounting the old DATA at $mnt failed, keeping the marker"
	if mountpoint -q "$mnt"; then
		return 0
	fi
	rmdir "$mnt" 2>/dev/null || true
	rm -f "$marker"
	sync
	log "copied $copied file(s) from $from, removed the migration marker"
}

migrate_from_marker
