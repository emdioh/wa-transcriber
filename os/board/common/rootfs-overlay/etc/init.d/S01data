#!/bin/sh
#
# Create and mount the DATA partition on first boot.
#
# The image ships with two partitions: boot (FAT) and root (ext4, read-only).
# The rest of the card becomes DATA (ext4, label DATA) the first time the
# device boots, so the image stays small and the card can be of any size.
#
# Must be idempotent: a power cut at any point must not brick the card.
# Called from rcS before anything writes to /data.

log() {
	echo "S01data: $*" >/dev/kmsg 2>/dev/null || echo "S01data: $*"
}

. /usr/lib/wat/sd.sh

# Root device, e.g. /dev/mmcblk0p2 or /dev/sda2. /proc/mounts calls it
# /dev/root, so the device comes from /sys/dev/block (see sd.sh).
rootdev=$(wat_rootdev) || rootdev=
if [ -z "$rootdev" ]; then
	log "cannot find the root block device, /data stays unmounted"
	exit 0
fi
disk=$(wat_disk "$rootdev") || disk=
if [ -z "$disk" ]; then
	log "root device $rootdev is not a partition of a disk, /data stays unmounted"
	exit 0
fi
datadev=$(wat_part "$disk" 3)

wait_for_block() {
	i=0
	while [ ! -b "$1" ] && [ "$i" -lt 50 ]; do
		sleep 0.2
		i=$((i + 1))
	done
	[ -b "$1" ]
}

if ! wait_for_block "$datadev"; then
	log "no partition 3 on $disk, creating it"
	# start=(first free), size=rest of the disk, type=83 (Linux).
	# Let sfdisk re-read the table itself (it adds the partition with the
	# BLKPG ioctl, which works while the disk is in use and mounted).
	if ! printf ',+,83\n' | sfdisk --append "$disk"; then
		log "sfdisk failed, /data stays unmounted"
		exit 0
	fi
	# Belt and braces: if the ioctl path did not create the node, ask the
	# kernel to re-read the table (may fail with EBUSY, hence "|| true").
	blockdev --rereadpt "$disk" 2>/dev/null || true
	mdev -s 2>/dev/null || true
	if ! wait_for_block "$datadev"; then
		log "$datadev did not appear, /data stays unmounted"
		exit 0
	fi
fi

# A partition that exists but carries no filesystem (power cut during the
# first boot) is formatted here; an existing DATA filesystem is never
# touched.
if ! blkid "$datadev" | grep -q 'LABEL="DATA"'; then
	log "formatting $datadev as DATA"
	if ! mkfs.ext4 -q -L DATA "$datadev"; then
		log "mkfs.ext4 failed, /data stays unmounted"
		exit 0
	fi
fi

mkdir -p /data
if ! mount /data; then
	log "mounting /data failed"
	exit 0
fi
log "DATA mounted from $datadev"
