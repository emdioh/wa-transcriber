#!/bin/sh
#
# Keep the clock right: WhatsApp refuses to connect with a badly wrong clock,
# and the binary waits for it (adjtimex reports synced).
#
# Two servers so a single DNS failure does not leave the device without time.

NTPD_ARGS="-p pool.ntp.org -p time.cloudflare.com"

case "$1" in
start)
	printf "Starting ntpd: "
	modprobe nf_conntrack 2>/dev/null || true
	# busybox ntpd daemonises by itself.
	if ntpd $NTPD_ARGS; then echo "OK"; else echo "FAIL"; fi
	;;
stop)
	printf "Stopping ntpd: "
	killall ntpd 2>/dev/null && echo "OK" || echo "not running"
	;;
restart|reload)
	"$0" stop
	"$0" start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
	;;
esac
