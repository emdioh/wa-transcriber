# wa-transcriber image for the Raspberry Pi 1 (and the Pi Zero, Pi 1 A+/B+,
# CM1: all BCM2835, ARM1176).
# Derived from Buildroot's raspberrypi_defconfig; see os/README.md.
#
# This board is ARMv6: it needs its own toolchain, its own kernel and the
# GOARM=6 binary. The rpi2 image cannot boot it (ARMv7 kernel).

# Architecture (BCM2835: one ARM1176JZF-S, no NEON)
BR2_arm=y
BR2_arm1176jzf_s=y
BR2_ARM_EABIHF=y

# Toolchain: musl + static-friendly defaults. The transcriber itself is a
# static Go binary; the C libraries are only for e2fsprogs, wpa_supplicant
# and hostapd.
BR2_TOOLCHAIN_BUILDROOT_MUSL=y

BR2_SYSTEM_DHCP=""
BR2_TARGET_GENERIC_HOSTNAME="wa"
BR2_TARGET_GENERIC_ISSUE="wa-transcriber"
BR2_TARGET_GENERIC_ROOT_PASSWD=""
# BR2_TARGET_GENERIC_GETTY is not set

# Read-only root: nothing is written outside /data (and the tmpfs mounts).
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set

# Barebones appliance: kernel devtmpfs, no init system, no /bin/sh, no BusyBox.
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_NONE=y

# Linux kernel: the Raspberry Pi tree, the BCM2835 configuration.
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_1=y
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,17f135b742c4edb340afb365873c3a574f7e16cb)/linux-17f135b742c4edb340afb365873c3a574f7e16cb.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcmrpi"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_WAT_PATH)/board/common/linux.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
# The firmware picks the dtb by the detected model, so every BCM2835 one has
# to be on the boot partition: a board whose dtb is missing boots into
# nothing at all (no HDMI, no serial).
# Both naming families: the kernel ships bcm2708-rpi-* (old) and bcm2835-rpi-*
# (what current firmware asks for), and a board whose dtb is missing gets
# an LED error code and no screen at all.
BR2_LINUX_KERNEL_INTREE_DTS_NAME="bcm2708-rpi-b bcm2708-rpi-b-plus bcm2708-rpi-b-rev1 bcm2708-rpi-cm bcm2708-rpi-zero bcm2708-rpi-zero-w bcm2835-rpi-a bcm2835-rpi-a-plus bcm2835-rpi-b bcm2835-rpi-b-plus bcm2835-rpi-b-rev2 bcm2835-rpi-zero bcm2835-rpi-zero-w"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Boot firmware: ship both default (start.elf) and cut-down (start_cd.elf).
# config.txt sets gpu_mem=16, which makes bootcode.bin load start_cd.elf and
# fixup_cd.dat instead of start.elf; without them it halts with 3 LED flashes
# and no rainbow screen.
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_BOOTCODE_BIN=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI_CD=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_WAT_PATH)/board/rpi1/config.txt"
# BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTB_OVERLAYS is not set

# Userspace: wa-transcriber (PID 1) plus only e2fsprogs, WiFi daemons,
# firmware/regdb and CA certs.
# BR2_PACKAGE_BUSYBOX is not set
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_HOSTAPD_DRIVER_NL80211=y
BR2_PACKAGE_WIRELESS_REGDB=y
# WiFi firmware blobs for the drivers in board/common/linux.fragment:
# mt76x2u needs mt7662*.bin, rtl8xxxu rtlwifi/rtl8192eu_nic.bin. Trimmed to
# those two drivers only, not the whole linux-firmware tree.
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT76X2E=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_81XX=y
BR2_PACKAGE_CA_CERTIFICATES=y

# Our own binary (copied from the Go cross-build), ARMv6 for this board.
BR2_PACKAGE_WA_TRANSCRIBER=y
BR2_PACKAGE_WA_TRANSCRIBER_ARCH="armv6"

# Filesystem and images
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_LABEL="rootfs"
BR2_TARGET_ROOTFS_EXT2_SIZE="160M"
# BR2_TARGET_ROOTFS_TAR is not set

BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_WAT_PATH)/board/rpi1/post-build.sh"

# genimage: run by os/Makefile after the build (not by Buildroot), so the
# board layout stays in this tree.
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
